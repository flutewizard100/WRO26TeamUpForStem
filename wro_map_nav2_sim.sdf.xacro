<?xml version="1.0"?>

<sdf version="1.9"
     xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       WRO FUTURE ENGINEERS 2026 FIELD
       Intended for:
         - ROS 2
         - Gazebo Sim Harmonic or newer
         - SDFormat 1.9

       Units:
         - metres
         - kilograms
         - radians

       Generate with:
         ros2 run xacro xacro \
           wro_future_engineers_field.sdf.xacro \
           -o wro_future_engineers_field.sdf

       The official field dimensions represented here are:
         Mat:                     3.200 x 3.200 m
         Racetrack internal area: 3.000 x 3.000 m
         Wall height:             0.100 m
         Traffic sign:            0.050 x 0.050 x 0.100 m
         Parking barrier:         0.200 x 0.020 x 0.100 m

       Wall thickness is not defined by WRO.
       This simulation uses 0.020 m by default.

       IMPORTANT:
       The traffic-sign and parking positions below are an example
       obstacle layout. Change them to match your randomized round.
       ================================================================ -->


  <!-- ========================== ARGUMENTS ========================== -->

  <!-- World -->
  <xacro:arg name="world_name" default="wro_future_engineers"/>
  <xacro:arg name="paused" default="false"/>

  <!-- Open challenge: false; obstacle challenge: true -->
  <xacro:arg name="with_obstacles" default="true"/>

  <!-- Parking barriers -->
  <xacro:arg name="with_parking" default="true"/>

  <!--
       Inner wall outside dimensions.

       1.0 m inner wall gives approximately 1.0 m track corridors.
       1.8 m inner wall gives approximately 0.6 m track corridors.
       1.4 m is available for rectangular/randomized configurations.

       Examples:
         inner_x:=1.0 inner_y:=1.0
         inner_x:=1.8 inner_y:=1.8
         inner_x:=1.0 inner_y:=1.8
         inner_x:=1.4 inner_y:=1.0
  -->
  <xacro:arg name="inner_x" default="1.0"/>
  <xacro:arg name="inner_y" default="1.0"/>

  <!-- WRO does not officially specify wall thickness -->
  <xacro:arg name="wall_thickness" default="0.020"/>

  <!-- Surface properties -->
  <xacro:arg name="field_friction" default="0.80"/>
  <xacro:arg name="field_friction2" default="0.80"/>

  <!--
       Set true after installing:
       model://wro_future_engineers_field/materials/textures/wro_fe_2026_mat.png
  -->
  <xacro:arg name="use_mat_texture" default="false"/>


  <!-- ========================== PROPERTIES ========================= -->

  <xacro:property name="WORLD_NAME" value="$(arg world_name)"/>

  <xacro:property name="MAT_SIZE" value="3.2"/>
  <xacro:property name="TRACK_SIZE" value="3.0"/>

  <xacro:property name="WALL_HEIGHT" value="0.1"/>
  <xacro:property name="WALL_T" value="$(arg wall_thickness)"/>

  <xacro:property name="INNER_X" value="$(arg inner_x)"/>
  <xacro:property name="INNER_Y" value="$(arg inner_y)"/>

  <xacro:property name="SIGN_X" value="0.05"/>
  <xacro:property name="SIGN_Y" value="0.05"/>
  <xacro:property name="SIGN_Z" value="0.10"/>

  <xacro:property name="PARKING_X" value="0.20"/>
  <xacro:property name="PARKING_Y" value="0.02"/>
  <xacro:property name="PARKING_Z" value="0.10"/>


  <!-- =========================== MACROS ============================ -->

  <!-- Static box used for walls and barriers -->
  <xacro:macro name="static_box"
               params="name x y z sx sy sz r g b a:=1.0">

    <model name="${name}">
      <static>true</static>

      <pose>${x} ${y} ${z} 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>${sx} ${sy} ${sz}</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.80</mu>
                <mu2>0.80</mu2>
              </ode>
            </friction>

            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>${sx} ${sy} ${sz}</size>
            </box>
          </geometry>

          <material>
            <ambient>${r} ${g} ${b} ${a}</ambient>
            <diffuse>${r} ${g} ${b} ${a}</diffuse>
            <specular>0.02 0.02 0.02 1</specular>

            <pbr>
              <metal>
                <roughness>0.95</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

      </link>
    </model>
  </xacro:macro>


  <!-- Visual-only line on the floor -->
  <xacro:macro name="floor_line"
               params="name x y yaw length width r g b">

    <model name="${name}">
      <static>true</static>

      <pose>${x} ${y} 0.0015 0 0 ${yaw}</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>${length} ${width} 0.001</size>
            </box>
          </geometry>

          <material>
            <ambient>${r} ${g} ${b} 1</ambient>
            <diffuse>${r} ${g} ${b} 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </xacro:macro>


  <!-- Movable traffic sign -->
  <xacro:macro name="traffic_sign"
               params="name x y colour">

    <model name="${name}">
      <static>false</static>

      <!-- Bottom of the sign is at field level -->
      <pose>${x} ${y} ${SIGN_Z / 2.0} 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.10</mass>

          <!-- Cuboid inertia for 0.05 x 0.05 x 0.10 m -->
          <inertia>
            <ixx>0.00010417</ixx>
            <iyy>0.00010417</iyy>
            <izz>0.00004167</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>${SIGN_X} ${SIGN_Y} ${SIGN_Z}</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.65</mu>
                <mu2>0.65</mu2>
              </ode>
            </friction>

            <contact>
              <ode>
                <kp>500000</kp>
                <kd>50</kd>
                <max_vel>0.02</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>${SIGN_X} ${SIGN_Y} ${SIGN_Z}</size>
            </box>
          </geometry>

          <material>
            <xacro:if value="${colour == 'red'}">
              <!-- Official WRO RGB: 238, 39, 55 -->
              <ambient>0.933 0.153 0.216 1</ambient>
              <diffuse>0.933 0.153 0.216 1</diffuse>
            </xacro:if>

            <xacro:if value="${colour == 'green'}">
              <!-- Official WRO RGB: 68, 214, 44 -->
              <ambient>0.267 0.839 0.173 1</ambient>
              <diffuse>0.267 0.839 0.173 1</diffuse>
            </xacro:if>

            <specular>0.02 0.02 0.02 1</specular>

            <pbr>
              <metal>
                <roughness>0.90</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

      </link>
    </model>
  </xacro:macro>


  <!-- Parking barrier -->
  <xacro:macro name="parking_barrier"
               params="name x y yaw">

    <model name="${name}">
      <static>true</static>

      <pose>${x} ${y} ${PARKING_Z / 2.0} 0 0 ${yaw}</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>${PARKING_X} ${PARKING_Y} ${PARKING_Z}</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.80</mu>
                <mu2>0.80</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>${PARKING_X} ${PARKING_Y} ${PARKING_Z}</size>
            </box>
          </geometry>

          <material>
            <!-- Official parking-barrier colour: RGB 255, 0, 255 -->
            <ambient>1 0 1 1</ambient>
            <diffuse>1 0 1 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>

            <pbr>
              <metal>
                <roughness>0.90</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

      </link>
    </model>
  </xacro:macro>


  <!-- ============================ WORLD ============================ -->

  <world name="${WORLD_NAME}">

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="wro_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>

        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>


    <!-- Gazebo Sim systems -->

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>


    <!-- Lighting -->

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 -0.3 -1.0</direction>
    </light>

    <light name="field_fill_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.8</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>


    <!-- ========================= FIELD MAT ========================= -->

    <model name="wro_field_mat">
      <static>true</static>

      <!-- Top surface is at Z=0 -->
      <pose>0 0 -0.01 0 0 0</pose>

      <link name="field_mat_link">

        <collision name="field_mat_collision">
          <geometry>
            <box>
              <size>${MAT_SIZE} ${MAT_SIZE} 0.02</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>$(arg field_friction)</mu>
                <mu2>$(arg field_friction2)</mu2>
                <fdir1>1 0 0</fdir1>
              </ode>

              <torsional>
                <coefficient>0.20</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.01</patch_radius>
                <surface_radius>0.01</surface_radius>
              </torsional>
            </friction>

            <contact>
              <collide_bitmask>65535</collide_bitmask>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="field_mat_visual">
          <geometry>
            <box>
              <size>${MAT_SIZE} ${MAT_SIZE} 0.02</size>
            </box>
          </geometry>

          <!-- Plain white material -->
          <xacro:unless value="$(arg use_mat_texture)">
            <material>
              <ambient>0.92 0.92 0.92 1</ambient>
              <diffuse>0.92 0.92 0.92 1</diffuse>
              <specular>0.01 0.01 0.01 1</specular>

              <pbr>
                <metal>
                  <roughness>1.0</roughness>
                  <metalness>0.0</metalness>
                </metal>
              </pbr>
            </material>
          </xacro:unless>

          <!-- Optional field texture -->
          <xacro:if value="$(arg use_mat_texture)">
            <material>
              <ambient>1 1 1 1</ambient>
              <diffuse>1 1 1 1</diffuse>

              <pbr>
                <metal>
                  <albedo_map>
                    model://wro_future_engineers_field/materials/textures/wro_fe_2026_mat.png
                  </albedo_map>
                  <roughness>1.0</roughness>
                  <metalness>0.0</metalness>
                </metal>
              </pbr>
            </material>
          </xacro:if>

        </visual>
      </link>
    </model>


    <!-- ======================== OUTER WALLS ========================

         The inside faces are positioned at +/- 1.500 m.
         The selected wall thickness extends outside the track.
    -->

    <xacro:static_box
      name="outer_wall_north"
      x="0"
      y="${TRACK_SIZE / 2.0 + WALL_T / 2.0}"
      z="${WALL_HEIGHT / 2.0}"
      sx="${TRACK_SIZE + 2.0 * WALL_T}"
      sy="${WALL_T}"
      sz="${WALL_HEIGHT}"
      r="0.015" g="0.015" b="0.015"/>

    <xacro:static_box
      name="outer_wall_south"
      x="0"
      y="${-TRACK_SIZE / 2.0 - WALL_T / 2.0}"
      z="${WALL_HEIGHT / 2.0}"
      sx="${TRACK_SIZE + 2.0 * WALL_T}"
      sy="${WALL_T}"
      sz="${WALL_HEIGHT}"
      r="0.015" g="0.015" b="0.015"/>

    <xacro:static_box
      name="outer_wall_east"
      x="${TRACK_SIZE / 2.0 + WALL_T / 2.0}"
      y="0"
      z="${WALL_HEIGHT / 2.0}"
      sx="${WALL_T}"
      sy="${TRACK_SIZE}"
      sz="${WALL_HEIGHT}"
      r="0.015" g="0.015" b="0.015"/>

    <xacro:static_box
      name="outer_wall_west"
      x="${-TRACK_SIZE / 2.0 - WALL_T / 2.0}"
      y="0"
      z="${WALL_HEIGHT / 2.0}"
      sx="${WALL_T}"
      sy="${TRACK_SIZE}"
      sz="${WALL_HEIGHT}"
      r="0.015" g="0.015" b="0.015"/>


    <!-- ======================== INNER WALLS ========================

         INNER_X and INNER_Y represent the outside dimensions of the
         inner-wall rectangle. This makes the corridor widths:

           East/west corridor = (3.0 - INNER_X) / 2
           North/south corridor = (3.0 - INNER_Y) / 2
    -->

    <xacro:static_box
      name="inner_wall_north"
      x="0"
      y="${INNER_Y / 2.0 - WALL_T / 2.0}"
      z="${WALL_HEIGHT / 2.0}"
      sx="${INNER_X}"
      sy="${WALL_T}"
      sz="${WALL_HEIGHT}"
      r="0.01" g="0.01" b="0.01"/>

    <xacro:static_box
      name="inner_wall_south"
      x="0"
      y="${-INNER_Y / 2.0 + WALL_T / 2.0}"
      z="${WALL_HEIGHT / 2.0}"
      sx="${INNER_X}"
      sy="${WALL_T}"
      sz="${WALL_HEIGHT}"
      r="0.01" g="0.01" b="0.01"/>

    <xacro:static_box
      name="inner_wall_east"
      x="${INNER_X / 2.0 - WALL_T / 2.0}"
      y="0"
      z="${WALL_HEIGHT / 2.0}"
      sx="${WALL_T}"
      sy="${INNER_Y - 2.0 * WALL_T}"
      sz="${WALL_HEIGHT}"
      r="0.01" g="0.01" b="0.01"/>

    <xacro:static_box
      name="inner_wall_west"
      x="${-INNER_X / 2.0 + WALL_T / 2.0}"
      y="0"
      z="${WALL_HEIGHT / 2.0}"
      sx="${WALL_T}"
      sy="${INNER_Y - 2.0 * WALL_T}"
      sz="${WALL_HEIGHT}"
      r="0.01" g="0.01" b="0.01"/>


    <!-- ===================== COLOURED LINES ========================

         These provide simple 20 mm visual reference lines when the
         official mat texture is not installed.

         For exact printed markings, use the official field-mat image
         as the floor texture.
    -->

    <xacro:unless value="$(arg use_mat_texture)">

      <!-- Orange reference lines -->
      <xacro:floor_line
        name="orange_line_north"
        x="-0.55" y="1.25" yaw="0"
        length="0.45" width="0.02"
        r="1.0" g="0.40" b="0.0"/>

      <xacro:floor_line
        name="orange_line_south"
        x="0.55" y="-1.25" yaw="0"
        length="0.45" width="0.02"
        r="1.0" g="0.40" b="0.0"/>

      <xacro:floor_line
        name="orange_line_east"
        x="1.25" y="0.55" yaw="${pi / 2.0}"
        length="0.45" width="0.02"
        r="1.0" g="0.40" b="0.0"/>

      <xacro:floor_line
        name="orange_line_west"
        x="-1.25" y="-0.55" yaw="${pi / 2.0}"
        length="0.45" width="0.02"
        r="1.0" g="0.40" b="0.0"/>

      <!-- Blue reference lines -->
      <xacro:floor_line
        name="blue_line_north"
        x="0.55" y="1.25" yaw="0"
        length="0.45" width="0.02"
        r="0.0" g="0.20" b="0.80"/>

      <xacro:floor_line
        name="blue_line_south"
        x="-0.55" y="-1.25" yaw="0"
        length="0.45" width="0.02"
        r="0.0" g="0.20" b="0.80"/>

      <xacro:floor_line
        name="blue_line_east"
        x="1.25" y="-0.55" yaw="${pi / 2.0}"
        length="0.45" width="0.02"
        r="0.0" g="0.20" b="0.80"/>

      <xacro:floor_line
        name="blue_line_west"
        x="-1.25" y="0.55" yaw="${pi / 2.0}"
        length="0.45" width="0.02"
        r="0.0" g="0.20" b="0.80"/>

    </xacro:unless>


    <!-- ==================== OBSTACLE CHALLENGE =====================

         Example randomized configuration.

         Red signs must be passed on the vehicle's right.
         Green signs must be passed on the vehicle's left.

         Duplicate, remove or reposition these macros to create your
         selected competition-round layout.
    -->

    <xacro:if value="$(arg with_obstacles)">

      <!-- North section -->
      <xacro:traffic_sign
        name="red_sign_north_1"
        x="-0.55"
        y="1.10"
        colour="red"/>

      <xacro:traffic_sign
        name="green_sign_north_1"
        x="0.45"
        y="0.92"
        colour="green"/>

      <!-- East section -->
      <xacro:traffic_sign
        name="red_sign_east_1"
        x="1.10"
        y="0.45"
        colour="red"/>

      <xacro:traffic_sign
        name="green_sign_east_1"
        x="0.92"
        y="-0.48"
        colour="green"/>

      <!-- South section -->
      <xacro:traffic_sign
        name="red_sign_south_1"
        x="0.52"
        y="-1.10"
        colour="red"/>

      <xacro:traffic_sign
        name="green_sign_south_1"
        x="-0.48"
        y="-0.92"
        colour="green"/>

      <!-- West section -->
      <xacro:traffic_sign
        name="red_sign_west_1"
        x="-1.10"
        y="-0.45"
        colour="red"/>

      <xacro:traffic_sign
        name="green_sign_west_1"
        x="-0.92"
        y="0.48"
        colour="green"/>


      <!-- Example parking lot on south section -->
      <xacro:if value="$(arg with_parking)">

        <xacro:parking_barrier
          name="parking_barrier_left"
          x="-0.25"
          y="-1.37"
          yaw="${pi / 2.0}"/>

        <xacro:parking_barrier
          name="parking_barrier_right"
          x="0.25"
          y="-1.37"
          yaw="${pi / 2.0}"/>

      </xacro:if>

    </xacro:if>


    <!-- ============================ GUI ============================ -->

    <gui fullscreen="0">

      <plugin filename="GzScene3D"
              name="3D View">
        <gz-gui>
          <title>WRO Future Engineers 2026</title>
          <property type="bool" key="showTitleBar">true</property>
          <property type="string" key="state">docked</property>
        </gz-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.75 0.80 0.85</background_color>
        <camera_pose>4.4 -4.4 4.8 0 0.62 2.35</camera_pose>
      </plugin>

      <plugin filename="WorldControl"
              name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">true</property>
          <property type="bool" key="resizable">true</property>
          <property type="double" key="width">280</property>
          <property type="double" key="height">120</property>
          <property type="string" key="state">floating</property>
        </gz-gui>

        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>$(arg paused)</start_paused>
      </plugin>

      <plugin filename="WorldStats"
              name="World statistics">
        <gz-gui>
          <title>World statistics</title>
          <property type="bool" key="showTitleBar">true</property>
          <property type="bool" key="resizable">true</property>
          <property type="double" key="width">280</property>
          <property type="double" key="height">110</property>
          <property type="string" key="state">floating</property>
        </gz-gui>

        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="EntityTree"
              name="Entity tree">
        <gz-gui>
          <title>Entities</title>
          <property type="bool" key="showTitleBar">true</property>
          <property type="bool" key="resizable">true</property>
          <property type="double" key="width">280</property>
          <property type="double" key="height">400</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

    </gui>

  </world>
</sdf>
